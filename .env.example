# Copy to .env and fill in real values. Never commit .env.

# Admin password: full access (edit rounds, manage players, finish or trash games, import).
AUTH_PASSWORD=change-me-admin

# One password per group. GROUP_<NAME>_PASSWORD creates group <name> (lowercased).
# People who sign in with it see only that group's players, games and statistics.
# The otjes group comes pre-loaded with its players.
GROUP_OTJES_PASSWORD=change-me-otjes
# GROUP_FRIENDS_PASSWORD=another-password

# Signs session cookies. Use a long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=change-me-session-secret

# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false

# Set to true when running behind a reverse proxy (nginx, Caddy, Traefik) so rate limits use real client IPs.
TRUST_PROXY=false
