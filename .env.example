# Copy to .env and fill in real values. Never commit .env.

# Admin password: full access (edit rounds, manage players, finish or trash games).
AUTH_PASSWORD=change-me-admin

# Player password: can start games and enter round scores. Leave empty to disable player sign-in.
PLAYER_PASSWORD=change-me-player

# Signs session cookies. Use a long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=change-me-session-secret

# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false
