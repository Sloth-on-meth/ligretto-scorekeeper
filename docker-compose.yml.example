services:
  ligretto-scorekeeper:
    build:
      context: .
    image: ligretto-scorekeeper:latest
    network_mode: bridge
    ports:
      - "3001:3001"
    # Passwords and SESSION_SECRET come from .env (see .env.example).
    env_file:
      - path: .env
        required: false
    environment:
      PORT: 3001
      DB_PATH: /data/ligretto.db
    volumes:
      - ./data:/data
    restart: unless-stopped
