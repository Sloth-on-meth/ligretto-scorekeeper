services:
  ligretto-scorekeeper:
    build:
      context: .
    image: ligretto-scorekeeper:latest
    network_mode: bridge
    ports:
      - "3001:3001"
    # Passwords and SESSION_SECRET come from .env (see .env.example).
    env_file:
      - path: .env
        required: false
    environment:
      PORT: 3001
      DB_PATH: /data/ligretto.db
    volumes:
      - ./data:/data
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://localhost:3001/api/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]
      interval: 30s
      timeout: 5s
      retries: 3
    restart: unless-stopped
